    <properties>
        <java.version>21</java.version>
        <powsybl-dependencies.version>2026.1.0</powsybl-dependencies.version>
        <!--
            diffstacking: TEMPORARY. Pins the locally built powsybl-core SNAPSHOT that carries the diffstacking work
            (cgmes-rdfdb module, difference model import/export, partial SSH), which no released
            powsybl-dependencies contains yet. Remove this property *and* the explicit powsybl-core BOM
            import below once powsybl-dependencies ships a core release with those changes. Until then this
            pypowsybl tree only builds against a locally installed core SNAPSHOT: Maven Central has no such
            artifact, and snapshot-ci.yml rebuilds the powsybl-dependencies BOM instead of setting this property,
            so the hard-coded version here would override that BOM. Since the merge of upstream core main it is
            7.5.0-SNAPSHOT (voltage regulation refactoring powsybl-core#3699 included).
        -->
        <powsybl-core.version>7.5.0-SNAPSHOT</powsybl-core.version>
        <!--
            diffstacking: TEMPORARY, like powsybl-core.version above. The released libraries of
            powsybl-dependencies 2026.1.0 are compiled against core 7.3.0 and reference classes that core 7.5 removed
            (voltage regulation refactoring, powsybl-core#3699: StaticVarCompensator.RegulationMode,
            RatioTapChanger.RegulationMode, extensions RemoteReactivePowerControl, VoltagePerReactivePowerControl,
            VoltageRegulation; security LimitReduction). No adapted release exists yet, so these three are locally
            built SNAPSHOTs of their adapted upstream refs (OLF main fd435b3ca3, dynawo ci/core-7.4.0-SNAPSHOT
            1b2980aadf, optimizer voltage_regulation_refacto_adaptations 2620ca3), built with
            -Dpowsybl-core.version=7.5.0-SNAPSHOT (so against the local core SNAPSHOT above, open-reac also with
            -Dpowsybl-open-loadflow.version=2.4.0-SNAPSHOT) and installed into ~/.m2: this tree builds only where
            they were built. Diagram, entsoe and open-rao releases link against core 7.5 unchanged and stay on
            powsybl-dependencies.
        -->
        <powsybl-open-loadflow.version>2.4.0-SNAPSHOT</powsybl-open-loadflow.version>
        <powsybl-dynawo.version>3.4.0-SNAPSHOT</powsybl-dynawo.version>
        <powsybl-open-reac.version>0.19.0-SNAPSHOT</powsybl-open-reac.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
                diffstacking: TEMPORARY, remove together with the powsybl-core.version property above.
                The powsybl-core BOM is imported explicitly and *before* powsybl-dependencies, so that the SNAPSHOT
                wins. Overriding powsybl-core.version alone is not enough: an imported BOM is interpolated with its
                own properties, so powsybl-dependencies would still pin the released version. The first import of a
                managed dependency wins, hence the order.
            -->
            <dependency>
                <groupId>com.powsybl</groupId>
                <artifactId>powsybl-core</artifactId>
                <version>${powsybl-core.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- diffstacking: TEMPORARY, the library SNAPSHOTs of the properties above; first import wins. -->
            <dependency>
                <groupId>com.powsybl</groupId>
                <artifactId>powsybl-open-loadflow</artifactId>
                <version>${powsybl-open-loadflow.version}</version>
            </dependency>
            <dependency>
                <groupId>com.powsybl</groupId>
                <artifactId>powsybl-dynawo</artifactId>
                <version>${powsybl-dynawo.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.powsybl</groupId>
                <artifactId>powsybl-dependencies</artifactId>
                <version>${powsybl-dependencies.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <module>pypowsybl</module>
    </modules>
</project>
